new file mode 100644
index 0000000..681160f
--- /dev/null
+++ b/src/scene/underwater.ts
@@ -0,0 +1,179 @@
+/**
+ * PROTOTYPE (throwaway, underwater items 1–2 of docs/research/water-physics/underwater.md).
+ * Rich only, only while the camera is under the surface:
+ *  - item 1: fog and colour from the spot's own water, per channel, with a readability floor,
+ *    brightest looking up and dimming with depth, and a seabed lit by the actual sun and sky;
+ *  - item 2: the surface from below (in richWaterGlsl.ts): Snell's window, the mirror beyond it,
+ *    foam and plume as a glowing ceiling; no caustics under whitewater (in SpotSeabed.ts).
+ * Tags: [sourced] from a cited value; [est] an estimate or rendering choice.
+ */
+import {
+  Color, DepthTexture, HalfFloatType, Mesh, OrthographicCamera, PlaneGeometry, type PerspectiveCamera, Scene,
+  ShaderMaterial, Vector2, Vector3, type WebGLRenderer, WebGLRenderTarget,
+} from 'three';
+import { WATER_IOR, schlickFresnel } from './waterOptics';
+
+/** The owner's readability floor: a black object stays visible at least this far, m (decision 2026-09-29: 6–8 m). */
+export const VISIBILITY_FLOOR = 7;
+/** A black target vanishes at 4.8/c (Davies-Colley 1988; Zaneveld & Pegau 2003: within ~10 %) [sourced]. */
+export const SIGHTING = 4.8;
+/** Tyler 1960 (Lake Pend Oreille, 6.1 m): zenith 25× the horizontal, horizontal 7× the nadir (175/25) [sourced]. */
+export const TYLER = { zenithOverLevel: 25, levelOverNadir: 7 } as const;
+/** Mean path stretch of diffuse sky light, 1/μ̄_d with μ̄_d ≈ 0.83 [est]. */
+const DIFFUSE_STRETCH = 1.2;
+/** Fresnel reflectance of uniform diffuse sky light entering water, ≈ 0.066 for n = 1.333 [sourced, textbook]. */
+const DIFFUSE_FRESNEL = 0.066;
+
+/**
+ * The eye path's beam attenuation, per channel: the spot's own c, scaled down (all channels alike, keeping the hue)
+ * so the green channel's black-target sighting 4.8/c_G is never shorter than the floor. Light from above keeps the
+ * physical K (Subnautica decoupled the sun's attenuation from the eye path's the same way).
+ */
+export function eyeAttenuation(beam: Vector3, floor = VISIBILITY_FLOOR): Vector3 {
+  const scale = Math.min(1, SIGHTING / floor / Math.max(1e-6, beam.y));
+  return beam.clone().multiplyScalar(scale);
+}
+
+/** Irradiance on a level plane just under the surface: the direct sun and the sky, after Fresnel. */
+export function underwaterIrradiance(sunDirection: Vector3, sunRadiance: Color, skyIrradiance: number): { sun: Vector3; sky: Vector3; sunWater: Vector3 } {
+  const mu = Math.max(0, sunDirection.y);
+  const direct = mu * (1 - schlickFresnel(mu));
+  // Toward the sun under water: the refracted ray reversed; its height is the refracted cosine.
+  const muWater = Math.sqrt(1 - (1 - mu * mu) / (WATER_IOR * WATER_IOR));
+  const horizontal = new Vector2(sunDirection.x, sunDirection.z);
+  const sine = Math.sqrt(Math.max(0, 1 - muWater * muWater));
+  if (horizontal.lengthSq() > 1e-9) horizontal.normalize().multiplyScalar(sine);
+  return {
+    sun: new Vector3(sunRadiance.r, sunRadiance.g, sunRadiance.b).multiplyScalar(direct),
+    // The sky's colour is not in the sky manifest: taken grey [est].
+    sky: new Vector3(1, 1, 1).multiplyScalar(skyIrradiance * (1 - DIFFUSE_FRESNEL)),
+    sunWater: new Vector3(horizontal.x, muWater, horizontal.y),
+  };
+}
+
+/** Shared by the Rich water, the seabed and the composite pass. */
+export const underwaterUniforms = {
+  uwActive: { value: 0 },
+  uwSunIrradiance: { value: new Vector3() },
+  uwSkyIrradiance: { value: new Vector3() },
+  uwSunWater: { value: new Vector3(0, 1, 0) },
+  uwEyeAttenuation: { value: new Vector3(0.2, 0.2, 0.2) },
+};
+
+/**
+ * GLSL shared by every underwater user. Needs `waterDiffuseAttenuation`, `waterDeepReflectance`, `waterBedAlbedo`.
+ * uwDownwelling: E_d(z) = E_sun e^{−K z/μ_w} + E_sky e^{−1.2 K z} (Gordon's K, the game's `diffuseAttenuation`).
+ * uwRadiance: the water's own radiance along `dir` at depth z (what fills a long path):
+ *  - level: 7 × the nadir radiance R∞ E_d/π (Morel & Prieur R∞, Q = π [est], Tyler's level/nadir = 7);
+ *  - down to the nadir: falls to R∞ E_d/π;
+ *  - up: rises toward the zenith, Tyler's 25× level, capped at what the sky can send through the window
+ *    (n² (1 − F) E_d/π for a uniform sky), interpolated in log space as μ^1.5 [est shape].
+ */
+export const underwaterPars = /* glsl */ `
+uniform float uwActive;
+uniform vec3 uwSunIrradiance;
+uniform vec3 uwSkyIrradiance;
+uniform vec3 uwSunWater;
+uniform vec3 uwEyeAttenuation;
+
+vec3 uwDownwelling( float z ) {
+  z = max( z, 0.0 );
+  return uwSunIrradiance * exp( -waterDiffuseAttenuation * z / max( uwSunWater.y, 0.2 ) )
+    + uwSkyIrradiance * exp( -waterDiffuseAttenuation * ${DIFFUSE_STRETCH.toFixed(2)} * z );
+}
+
+vec3 uwRadiance( vec3 dir, float z ) {
+  vec3 ed = uwDownwelling( z ) / PI;
+  vec3 level = ${TYLER.levelOverNadir.toFixed(1)} * waterDeepReflectance * ed;
+  float mu = dir.y;
+  if ( mu <= 0.0 ) return level * pow( ${(1 / TYLER.levelOverNadir).toFixed(4)}, -mu );
+  vec3 zenith = min( ${TYLER.zenithOverLevel.toFixed(1)} * level, ${(WATER_IOR * WATER_IOR * (1 - 0.02)).toFixed(3)} * ed );
+  float w = pow( mu, 1.5 );
+  return exp( mix( log( max( level, vec3( 1e-6 ) ) ), log( max( zenith, vec3( 1e-6 ) ) ), w ) );
+}
+
+// The Lambertian seabed at depth z, lit from above (no caustics).
+vec3 uwBedRadiance( float z ) {
+  return waterBedAlbedo * uwDownwelling( z ) / PI;
+}
+`;
+
+/**
+ * The fog as one composite: the scene drawn into a float target, then each pixel faded by e^{−c d} along its own
+ * view distance toward the water's radiance in its direction (Crest's per-channel form). A real implementation should
+ * do this inside the materials (tile GPUs, round 5 §4.3); a composite was quicker to prototype.
+ */
+export class UnderwaterPass {
+  private target?: WebGLRenderTarget;
+  private readonly size = new Vector2();
+  private readonly camera = new OrthographicCamera(-1, 1, 1, -1, 0, 1);
+  private readonly quad: Mesh<PlaneGeometry, ShaderMaterial>;
+  private readonly composite: Scene;
+
+  constructor(optics: Record<string, { value: unknown }>) {
+    const material = new ShaderMaterial({
+      uniforms: {
+        ...optics,
+        ...underwaterUniforms,
+        tColor: { value: null },
+        tDepth: { value: null },
+        uwProjectionInverse: { value: null },
+        uwCameraWorld: { value: null },
+        uwCameraDepth: { value: 0 },
+      },
+      vertexShader: /* glsl */ `
+varying vec2 vUv;
+void main() { vUv = uv; gl_Position = vec4( position.xy, 0.0, 1.0 ); }`,
+      fragmentShader: /* glsl */ `
+#include <common>
+uniform vec3 waterDiffuseAttenuation;
+uniform vec3 waterDeepReflectance;
+uniform vec3 waterBedAlbedo;
+${underwaterPars}
+uniform sampler2D tColor;
+uniform sampler2D tDepth;
+uniform mat4 uwProjectionInverse;
+uniform mat4 uwCameraWorld;
+uniform float uwCameraDepth;
+varying vec2 vUv;
+void main() {
+  float depth = texture2D( tDepth, vUv ).x;
+  vec4 view = uwProjectionInverse * vec4( vUv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0 );
+  view /= view.w;
+  float distance = depth >= 1.0 ? 1e4 : length( view.xyz );
+  vec3 dir = normalize( ( uwCameraWorld * vec4( normalize( view.xyz ), 0.0 ) ).xyz );
+  // The in-scatter comes mostly from within 1/c of the eye: take the water's radiance at that depth [est].
+  float reach = min( distance, 1.0 / max( uwEyeAttenuation.g, 1e-3 ) );
+  vec3 far = uwRadiance( dir, uwCameraDepth - dir.y * reach );
+  vec3 through = exp( -uwEyeAttenuation * distance );
+  gl_FragColor = vec4( texture2D( tColor, vUv ).rgb * through + far * ( 1.0 - through ), 1.0 );
+  #include <tonemapping_fragment>
+  #include <colorspace_fragment>
+}`,
+      depthTest: false,
+      depthWrite: false,
+    });
+    this.quad = new Mesh(new PlaneGeometry(2, 2), material);
+    this.quad.frustumCulled = false;
+    this.composite = new Scene();
+    this.composite.add(this.quad);
+  }
+
+  render(renderer: WebGLRenderer, scene: Scene, camera: PerspectiveCamera, cameraDepth: number): void {
+    renderer.getDrawingBufferSize(this.size);
+    if (!this.target || this.target.width !== this.size.x || this.target.height !== this.size.y) {
+      this.target?.dispose();
+      this.target = new WebGLRenderTarget(this.size.x, this.size.y, { type: HalfFloatType, depthTexture: new DepthTexture(this.size.x, this.size.y) });
+    }
+    renderer.setRenderTarget(this.target);
+    renderer.render(scene, camera);
+    renderer.setRenderTarget(null);
+    const uniforms = this.quad.material.uniforms;
+    uniforms.tColor.value = this.target.texture;
+    uniforms.tDepth.value = this.target.depthTexture;
+    uniforms.uwProjectionInverse.value = camera.projectionMatrixInverse;
+    uniforms.uwCameraWorld.value = camera.matrixWorld;
+    uniforms.uwCameraDepth.value = cameraDepth;
+    renderer.render(this.composite, this.camera);
+  }
+}
