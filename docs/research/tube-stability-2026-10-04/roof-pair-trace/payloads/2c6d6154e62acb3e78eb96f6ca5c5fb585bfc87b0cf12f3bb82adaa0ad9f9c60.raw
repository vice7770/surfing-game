  try { save(); } catch (error) {
    result.firstFailure ??= String(error); result.traceCompleted = false; process.exitCode = 1;
    const receipt = { schema: result.schema, traceCompleted: false, firstFailure: String(result.firstFailure).slice(0, 4096),
      reportSaveFailure: String(error).slice(0, 4096), inputClosureFailure: result.inputClosureFailure,
      previousReportPreserved: existsSync(join(OUT, 'report.json')), lastPhase: result.phase,
      inputsUnchangedBefore: result.inputsUnchangedBefore, inputsUnchangedAfter: result.inputsUnchangedAfter,
      arraysUnchangedAfter: result.arraysUnchangedAfter, nativeCaptureComplete: false, nineStateQuality: false,
      adoption: false, tubeQuality: false, fpsGate: false, geometryRepaired: false, finCauseProved: false };
    writeFileSync(join(OUT, 'first-failure.json'), JSON.stringify(receipt, sentinel) + '\n', { flag: 'wx' });
  }
  console.log(JSON.stringify({ report: join(OUT, 'report.json'), traceCompleted: result.traceCompleted,
    firstFailure: result.firstFailure, inputsUnchangedAfter: result.inputsUnchangedAfter, arraysUnchangedAfter: result.arraysUnchangedAfter,
    nativeCaptureComplete: false, tubeQuality: false, adoption: false, finCauseProved: false }));
}
