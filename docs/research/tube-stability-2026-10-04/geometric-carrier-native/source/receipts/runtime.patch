+export function copyCarrierPoint(point: FrontPoint): FrontPoint {
+  if (!point.carrierSupport) return { ...point };
+  return { ...point, carrierSupport: { ...point.carrierSupport, incidents: point.carrierSupport.incidents.map(i => ({ ...i })) } };
