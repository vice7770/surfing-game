{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": true, "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["node", "@webgpu/types"],
    "skipLibCheck": true, "moduleResolution": "Bundler", "allowImportingTsExtensions": true,
    "resolveJsonModule": true, "isolatedModules": true, "verbatimModuleSyntax": true,
    "moduleDetection": "force", "noEmit": true, "strict": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "noFallthroughCasesInSwitch": true
  },
  "include": ["source/src", "capture.test.ts", "vitest.capture.config.ts"]
}
