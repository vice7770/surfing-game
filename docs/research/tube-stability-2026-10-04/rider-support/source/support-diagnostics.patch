+    const water = new PlaneWater();
+    a.board.velocity.z = b.board.velocity.z = 6;
+    a.rider.velocity.z = b.rider.velocity.z = 6;
+    a.board.step(DT, water); b.board.step(DT, water);
+    // Mock only the runner's already-populated scalar/status dependencies. Do
+    // not construct a sea, advance physics, create a GPU, or call its gauge.
+    const fields = (pair: typeof a) => ({
+      simulation: { seaTime: 1, timeToSet: 2, lastStepMs: 0, device: null, solver: { nx: 1, nz: 1, time: 1 },
+        breakingFraction: () => 0, surf: { reading: () => null }, peelEstimate: () => null,
+        lipLaunches: 0, lipVolume: 0, lipJets: 0, lipRollers: 0, lip: { airborneVolume: () => 0 }, breaking: { onsetScale: 1 }, stepCosts: {} },
+      focus: { x: 0, z: 0 }, breaker: {}, breakDepth: 1, spray: { count: 0 }, board: pair.board,
+      session: { board: pair.board, rider: pair.rider, phase: pair.rider.phase, separation: undefined,
+        leash: { snapped: false, tension: 0, distance: 0, reeling: false }, surfer: { active: false },
+        recovery: { state: 'free' }, breath: { level: 1 } },
+      wave: { valid: false }, rideResets: 0, rescues: 0, snapshotKnock: 0,
+      boardMs: 0, contactMs: 0, bubbleMs: 0, sprayMs: 0, soundMs: 0, pipelineStepMs: 0,
+      snapshotFieldsMs: 0, fillMs: 0, batchMs: 0, batchSteps: 0,
+    });
+    const runner = Object.assign(Object.create(SurfZoneRunner.prototype), fields(a)) as SurfZoneRunner;
+    const baseline = Object.assign(Object.create(BaselineRunner.prototype), fields(b)) as BaselineRunner;
+    Object.defineProperty(runner, 'cue', { value: false });
+    Object.defineProperty(baseline, 'cue', { value: false });
+    const before = data(a);
+    const result = runner.status();
+    expect(data(a)).toBe(before);
+    const diagnostic = result.ride!.supportDiagnostics!;
+    ownerFixtures.push({ boardPose: [...a.board.position.toArray(), ...a.board.orientation.toArray(), 1], ride: { supportDiagnostics: diagnostic } });
+    expect(diagnostic.current).toEqual((a.rider as AttachedRider).supportDiagnostics.current);
+    expect(diagnostic.board.submergedVolume).toBe(a.board.submergedVolume);
+    expect(diagnostic.board.forces.pressure).toEqual({ x: a.board.forces.pressure.x, y: a.board.forces.pressure.y, z: a.board.forces.pressure.z });
