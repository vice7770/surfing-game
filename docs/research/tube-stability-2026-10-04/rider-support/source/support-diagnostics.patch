+import { Vector3 } from 'three';
+import { writeFileSync } from 'node:fs';
+import { afterAll, describe, expect, it } from 'vitest';
+import { AttachedRider, MAX_FLIGHT, RECOVERABLE_ERROR } from './AttachedRider';
+import { BoardBody } from './BoardBody';
+import { PlaneWater } from './PlaneWater';
+import { AttachedRider as BaselineRider } from '../../../baseline/src/physics/AttachedRider';
+import { BoardBody as BaselineBoard } from '../../../baseline/src/physics/BoardBody';
+import { SurfZoneRunner } from '../wave/SurfZoneRunner';
+import { SurfZoneRunner as BaselineRunner } from '../../../baseline/src/wave/SurfZoneRunner';
+
+const DT = 1 / 60;
+const ownerFixtures: unknown[] = [];
+afterAll(() => writeFileSync('/private/tmp/tube-rider-support-trace-20261004/support-fixtures.json', JSON.stringify({
+  scope: 'Actual CPU getter/status fixture data only; no native trajectory', rows: ownerFixtures,
+}, null, 2) + '\n'));
+
+function ownerRow(board: BoardBody, rider: AttachedRider) {
+  const vec = (v: { x: number; y: number; z: number }) => ({ x: v.x, y: v.y, z: v.z });
+  const q = board.orientation;
+  return { boardPose: [...board.position.toArray(), ...q.toArray(), 1], ride: { supportDiagnostics: {
+    ...rider.supportDiagnostics, board: {
+      position: vec(board.position), centerOfMass: vec(board.centerOfMass), velocity: vec(board.velocity), angularVelocity: vec(board.angularVelocity),
+      quaternion: { x: q.x, y: q.y, z: q.z, w: q.w },
+      forces: Object.fromEntries(Object.entries(board.forces).map(([key, value]) => [key, vec(value)])),
+      wettedArea: board.wettedArea, submergedVolume: board.submergedVolume, outsidePatches: board.outsidePatches, substepsTaken: board.substepsTaken,
+    },
+  } } };
+}
+
+// All enumerable public/private state, including work ledgers, solver scratch,
+// parts and contact. Only the isolated diagnostic records are excluded for the
+// baseline comparison. Getter-purity comparisons exclude nothing.
+function data(value: unknown, omitDiagnostics = false): string {
+  return JSON.stringify(value, (key, item) => {
+    if (omitDiagnostics && /^support[A-Z]/.test(key)) return undefined;
+    if (item instanceof Set) return [...item];
+    if (ArrayBuffer.isView(item)) return Array.from(item as unknown as ArrayLike<number>);
+    return item;
+  });
+}
+
+function mounted(phase: 'prone' | 'standing' = 'standing', baseline = false) {
+  // The independently imported baseline has distinct TS private-field identities;
+  // only this comparison fixture bridges them. Runtime objects remain original.
+  const board = (baseline ? new BaselineBoard() : new BoardBody()) as unknown as BoardBody;
+  board.place(new Vector3(0, board.shape.centerOfMass.y, 0));
+  const rider = (baseline ? new BaselineRider(board.shape, { phase }) : new AttachedRider(board.shape, { phase })) as unknown as AttachedRider;
+  board.attach(rider);
+  return { board, rider };
+}
+
+function countedWater() {
+  const water = new PlaneWater();
+  let queries = 0;
+  const sample = water.sampleAt.bind(water);
+  water.sampleAt = (...args) => { queries += 1; return sample(...args); };
+  return { water, queries: () => queries };
+}
+
+describe('isolated support diagnostics', () => {
+  it('is a pure getter with independent current and last-separation copies', () => {
+    const { board, rider } = mounted();
+    const r = rider as AttachedRider;
+    const { water, queries } = countedWater();
+    for (let i = 0; i < 360 && rider.attached; i++) board.step(DT, water);
+    expect(rider.attached).toBe(false);
+    const before = data({ board, rider });
+    const count = queries();
+    const first = r.supportDiagnostics;
+    expect(first.lastSeparation).not.toBeNull();
+    expect(first.lastSeparation!.state.attached).toBe(true);
+    const second = r.supportDiagnostics;
+    first.current.sway.x = 999;
+    first.current.leg.extension = 999;
+    first.current.cop.support.xMin = 999;
+    first.current.limitTime.tip = 999;
+    first.lastSeparation!.state.position.x = 999;
+    first.lastSeparation!.thresholds.recoverableErrorMetres = 999;
+    expect(r.supportDiagnostics).toEqual(second);
+    expect(data({ board, rider })).toBe(before);
+    expect(queries()).toBe(count);
+    rider.mount(board);
+    expect(r.supportDiagnostics.lastSeparation).toBeNull();
+    expect(r.supportDiagnostics.current.finishSubsteps).toBe(0);
+  });
+
+  it.each(['prone-popup', 'standing-crouch-towed', 'standing-unpowered'] as const)(
+    'keeps every ordinary physical state and water-query count byte equal to accepted source: %s', (mode) => {
+      const a = mounted(mode === 'prone-popup' ? 'prone' : 'standing');
+      const b = mounted(mode === 'prone-popup' ? 'prone' : 'standing', true);
+      const aw = countedWater(); const bw = countedWater();
+      let sawStanding = false; let sawSeparation = false;
+      for (let step = 1; step <= 360; step++) {
+        for (const { board, rider } of [a, b]) {
+          rider.paddle = true;
+          rider.steer = 0; rider.trim = 0; rider.compress = 0;
+          if (mode === 'prone-popup' && step === 11) rider.popUp();
