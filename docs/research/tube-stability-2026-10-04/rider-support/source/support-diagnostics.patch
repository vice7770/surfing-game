+    delete result.pipelineMs; delete old.pipelineMs;
+    expect(result).toEqual(old);
+  });
+
+  it.each(['flight-time', 'sway', 'posture-error'] as const)('records the exact existing %s release branch before detach', (branch) => {
+    const { board, rider } = mounted();
+    const r = rider as AttachedRider;
+    // This fixture isolates only finish()'s existing branch precedence. It
+    // deliberately prepares private state; the actual native trial never does.
+    const internal = r as unknown as { feasible: boolean; sway: Vector3; limit: string; limitTime: { tip: number }; frame: () => void; target: Vector3 };
+    internal.feasible = false;
+    internal.frame = () => {};
+    internal.target.copy(r.position);
+    r.velocity.set(0, 0, 0); board.velocity.set(0, 0, 0);
+    r.leg.extension = 1;
+    if (branch === 'flight-time') r.flightTime = MAX_FLIGHT + 0.01;
+    if (branch === 'sway') internal.sway.x = RECOVERABLE_ERROR + 0.01;
