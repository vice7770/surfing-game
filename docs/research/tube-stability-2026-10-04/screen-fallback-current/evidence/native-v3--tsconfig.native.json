{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "preserveSymlinks": true,
    "typeRoots": [
      "/Users/regina/Desktop/Projects/surfing-game/node_modules/@types"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@arm/*": [
        "../check/src/*"
      ]
    }
  },
  "files": [
    "entry.ts",
    "cavity.ts",
    "../check/src/wave/gpu/webgpu-env.d.ts"
  ]
}
