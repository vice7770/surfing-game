// Future root-owned single ordinary production arm. No runtime edit, transform, build or FPS threshold.
import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';
import { spawn } from 'node:child_process';
import { existsSync,lstatSync,mkdirSync,readFileSync,realpathSync } from 'node:fs';
import { createServer } from 'node:http';
import { extname,join,resolve } from 'node:path';
import { WORK,OUT,writeFileSync,outputBytes,METADATA,LOG_SHARE,RECEIPT,TOTAL } from './bounded-output.mjs';
import { tcpProof,sleep } from './native-owned.mjs';
const REPO='/Users/regina/Desktop/Projects/surfing-game',json=p=>JSON.parse(readFileSync(p,'utf8')),hash=b=>createHash('sha256').update(b).digest('hex');
const args=Object.fromEntries(process.argv.slice(2).map(value=>{const i=value.indexOf('=');assert(value.startsWith('--')&&i>2);return [value.slice(2,i),value.slice(i+1)];}));assert(Object.keys(args).every(key=>['run','out'].includes(key)));assert([undefined,'true','false'].includes(args.run));
const plan=json(join(WORK,'plan.json'));if(args.run!=='true'){console.log(JSON.stringify({planOnly:true,plan,resourcesStarted:false}));process.exit(0);}
const started=Date.now();assert.equal(process.env.ROOT_PASSIVE_NATIVE_LEASE,'true');assert.equal(hash(readFileSync(join(WORK,'ready.json'))),process.env.PASSIVE_READY_SHA256);assert.equal(hash(readFileSync(join(WORK,'bindings.json'))),process.env.PASSIVE_BINDINGS_SHA256);
const ready=json(join(WORK,'ready.json')),binding=json(join(WORK,'bindings.json'));assert.equal(binding.schema,'zero-mask-ordinary-fps-bindings/v1');assert.equal(binding.valid,true);assert.equal(binding.originalProduction,true);assert.equal(binding.ready.sha256,process.env.PASSIVE_READY_SHA256);assert.equal(resolve(args.out??OUT),OUT);assert(!existsSync(OUT),'Fresh one-shot native-first output required');mkdirSync(OUT);
function record(path){const p=resolve(path);assert(lstatSync(p).isFile()&&!lstatSync(p).isSymbolicLink());assert.equal(realpathSync(p),p);const body=readFileSync(p);return {path:p,bytes:body.length,sha256:hash(body)};}
function verify(pin){assert.deepEqual(record(pin.path),{path:pin.path,bytes:pin.bytes,sha256:pin.sha256});}
function authority(){for(const pin of [binding.ready,...ready.helpers,...ready.originalMeter,ready.originalDriver,...ready.sourceFiles,...ready.sourceCopies,ready.cdp,ready.borrowed,...binding.receipts,...binding.compiledFiles,binding.reference])verify(pin);assert(ready.sourceFiles.every(pin=>pin.path.startsWith(REPO+'/')));}
const report={schema:'zero-mask-ordinary-fps-native/v1',valid:false,incomplete:true,plan,ready:binding.ready,binding:record(join(WORK,'bindings.json')),startedAt:new Date(started).toISOString(),servedGETs:[],artifacts:[],fpsAcceptance:false,qualityPass:false,adoption:false,budgets:{allOutputCap:TOTAL,logShareBytes:LOG_SHARE,driverReceiptReservedBytes:RECEIPT,driverLogReservedBytes:LOG_SHARE,scope:'File retention caps only; browser/internal heap and peak RSS unavailable'}};
function save(){
  const path=join(OUT,'report.json'),otherBytes=outputBytes()-(existsSync(path)?lstatSync(path).size:0);
  report.budgets.nativeOutputByteCountScope='Retained native files at this report serialization, including this report via fixed point; active meter files may change before the next save. Sibling supervisor reservations are separate.';
  for(let pass=0;pass<8;pass+=1){const body=JSON.stringify(report,null,2)+'\n',next=otherBytes+Buffer.byteLength(body);if(report.budgets.nativeOutputBytes===next){writeFileSync(path,body);return;}report.budgets.nativeOutputBytes=next;}
  throw Error('Report retained-byte count failed to converge');
}
let server,meter,closing,logBytes=0,logBody='',aborted=false,terminal;
function firstFailure(error){report.firstFailure??=String(error);report.valid=false;process.exitCode=1;}
function stop(error){firstFailure(error);aborted=true;if(meter?.pid&&meter.exitCode===null&&meter.signalCode===null)meter.kill('SIGTERM');void cleanup().catch(error=>{report.cleanupFailure??=String(error);}).finally(()=>process.exit(1));}
function log(bytes){try{const text=bytes.toString(),next=logBytes+Buffer.byteLength(text);assert(next<=LOG_SHARE,'512KiB native log share within combined1MiB exceeded');logBytes=next;logBody+=text;writeFileSync(join(OUT,'native.log'),logBody);}catch(error){stop(error);}}
async function cleanup(){if(closing)return closing;closing=(async()=>{if(meter?.pid&&meter.exitCode===null&&meter.signalCode===null){meter.kill('SIGTERM');await Promise.race([new Promise(resolveChild=>meter.once('close',resolveChild)),sleep(1200)]);if(meter.exitCode===null&&meter.signalCode===null){meter.kill('SIGKILL');firstFailure('Meter required SIGKILL; external driver must prove group closure');}}if(server){server.closeAllConnections();await Promise.race([new Promise(resolveServer=>server.close(resolveServer)),sleep(300)]);}const ports=await Promise.allSettled([4259,9669].map(async port=>[port,await tcpProof(port)]));report.postPorts=Object.fromEntries(ports.filter(row=>row.status==='fulfilled').map(row=>row.value));report.endedAt=new Date().toISOString();report.elapsedSeconds=(Date.now()-started)/1000;if(report.postPorts[4259]?.closed!==true||report.postPorts[9669]?.closed!==true||report.elapsedSeconds>180)firstFailure('Owned local closure/deadline unproved');report.valid&&=!report.firstFailure;report.incomplete=!report.valid;try{save();}catch(error){firstFailure(error);report.incomplete=true;}return report;})();return closing;}
const deadline=setTimeout(()=>stop('Secondary175s command abort; external driver owns group/180s proof'),Math.max(1,175000-(Date.now()-started)));process.once('SIGTERM',()=>stop('External owned supervisor terminated command'));
try{
  authority();assert.equal(plan.serverPort,4259);assert.equal(plan.cdpPort,9669);assert.equal(plan.sampleSeconds,90);assert.equal(plan.warmSeconds,5);
  const pre=await Promise.allSettled([4259,9669].map(async port=>[port,await tcpProof(port)]));report.prePorts=Object.fromEntries(pre.filter(row=>row.status==='fulfilled').map(row=>row.value));for(const port of [4259,9669])assert.equal(report.prePorts[port]?.closed,true);
  // Read/hash each actual served buffer before any browser/sample. Frozen immutable buffers are handed unchanged to responses; no per-request hash during observation.
  const bodies=new Map();let bodyBytes=0;for(const pin of binding.compiledFiles){assert(pin.path.startsWith(WORK+'/dist/'));assert(pin.relativePath&&!pin.relativePath.startsWith('/')&&!pin.relativePath.split('/').includes('..'));const body=readFileSync(pin.path);assert.equal(body.length,pin.bytes);assert.equal(hash(body),pin.sha256);bodies.set(pin.relativePath,{pin,body});bodyBytes+=body.length;}assert(bodies.has('index.html')&&bodies.has(binding.worker));report.serving={setupBodyBytes:bodyBytes,scope:'Same immutable owned response buffers prehashed before browser launch; actual GET finish receipts below. Node serving buffers add memory outside the game; no actual peak memory claim.'};save();
  server=createServer((request,response)=>{try{assert(['GET','HEAD'].includes(request.method));const pathname=new URL(request.url,plan.url).pathname,rel=decodeURIComponent(pathname).replace(/^\/+/, '')||'index.html';assert(!rel.split('/').includes('..'));const row=bodies.get(rel);if(!row){response.writeHead(404);response.end();if(rel!=='favicon.ico')stop('Unknown served asset '+rel);return;}const mime={'.html':'text/html','.js':'text/javascript','.css':'text/css','.json':'application/json','.bin':'application/octet-stream','.glb':'model/gltf-binary','.png':'image/png','.jpg':'image/jpeg','.webp':'image/webp','.wav':'audio/wav','.ogg':'audio/ogg','.mp3':'audio/mpeg','.m4a':'audio/mp4','.hdr':'application/octet-stream','.svg':'image/svg+xml','.ico':'image/x-icon'};if(request.method==='GET'){assert(report.servedGETs.length<2048,'GET receipt bound exceeded');const receipt={route:request.url,relativePath:rel,bytes:row.body.length,sha256:row.pin.sha256,completed:false,scope:'Exact unchanged setup-hashed body buffer sent; finish proves server completion, not pixel identity'};report.servedGETs.push(receipt);response.once('finish',()=>{receipt.completed=true;});response.once('close',()=>{if(!receipt.completed)stop('Aborted GET '+request.url);});}response.writeHead(200,{'Content-Type':mime[extname(rel)]??'application/octet-stream','Content-Length':row.body.length,'Cache-Control':'no-store'});response.end(request.method==='HEAD'?undefined:row.body);}catch(error){if(!response.headersSent)response.writeHead(500);response.end();stop(error);}});
  await new Promise((yes,no)=>{server.once('error',no);server.listen(4259,'127.0.0.1',yes);});report.ownedServer={pid:process.pid,port:4259};
  const command=[join(WORK,'survey.mjs'),join(OUT,'fps.json'),`--url=${plan.url}`,`--dir=${join(WORK,'dist')}`,'--features=true','--only=High (baseline)','--spot=Padang','--swell=Big','--warmSeconds=5','--rideSeconds=90','--gpuTiming=false','--diagnosticGpu=false','--edition=single-step-publication','--width=1708','--height=966','--cdp=9669','--commit=working-tree-1099ddaa1',`--build=${binding.buildId}`,`--baseline=${binding.reference.path}`];
  meter=spawn(process.execPath,command,{cwd:WORK,env:{...process.env,FULL_WRITER_FPS_LAUNCHER_REPORT:join(OUT,'launcher.json'),FULL_WRITER_FPS_EXPECTED_WORKER:binding.worker,FULL_WRITER_FPS_EXPECTED_SOLO_ONE_STEP:'1'},stdio:['ignore','pipe','pipe']}); // Publish owned handle before any fallible evidence callback/write.
  report.meter={pid:meter.pid??null,command:[process.execPath,...command]};meter.stdout.on('data',log);meter.stderr.on('data',log);const completed=new Promise((yes,no)=>{meter.once('error',no);meter.once('close',(code,signal)=>yes({code,signal}));});save();terminal=await completed;report.terminal=terminal;assert(!aborted);assert.equal(terminal.code,0,'First meter failure ends single arm');
  const fps=json(join(OUT,'fps.json')),launcher=json(join(OUT,'launcher.json')),raw=json(join(OUT,'raw-samples.json'));assert.equal(fps.valid,true);assert.equal(fps.nativeAudit.valid,true);assert.equal(fps.results.length,1);assert.equal(fps.results[0].ordinaryConfigMatches,true);assert.equal(fps.gpuTiming,'disabled (passive counters)');assert.equal(launcher.ownedChromeClosed,true);assert(raw.endpoints.endedAt-raw.endpoints.startedAt>=90000&&raw.frames.length>1&&raw.snapshots.length>1,'Complete90s sample/raw endpoints absent');assert(raw.frames.every(row=>row.length===5&&row.every(Number.isFinite)));assert(report.servedGETs.some(row=>row.relativePath===binding.worker&&row.completed),'Actual original worker body receipt absent');
  authority();report.authorityUnchangedAfter=true;report.sample={frames:raw.frames.length,publications:raw.snapshots.length,endpoints:raw.endpoints,lateWindowsSeconds:plan.lateWindowsSeconds,metrics:'Original fps.json whole-sample statistics and two-second physics/pipeline timeline; retained raw timestamped callback/publication arrays permit declared late-window analysis, without an FPS acceptance threshold.'};
  for(const name of ['fps.json','raw-samples.json','native-audit.json','launcher.json','native.log'])if(existsSync(join(OUT,name)))report.artifacts.push(record(join(OUT,name)));assert(Date.now()-started<=175000,'Command exceeded175s before cleanup');report.valid=true;save();
}catch(error){firstFailure(error);report.incomplete=true;}
finally{await cleanup();clearTimeout(deadline);if(!report.valid)process.exitCode=1;console.log(JSON.stringify({valid:report.valid,incomplete:report.incomplete,firstFailure:report.firstFailure??null,report:join(OUT,'report.json'),elapsedSeconds:report.elapsedSeconds}));}
