// Future root-only source/compiled binding. Uses the first current root build/type observations; never builds or launches.
import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';
import { copyFileSync,existsSync,lstatSync,mkdirSync,readFileSync,readdirSync,realpathSync,writeFileSync } from 'node:fs';
import { dirname,join,relative,resolve } from 'node:path';
const WORK='/private/tmp/surf-zero-mask-fps-20261004',REPO='/Users/regina/Desktop/Projects/surfing-game',METER='/private/tmp/surf-nu-peak-fps-20261004',DRIVER='/private/tmp/surf-wavelab-passive-original-v2-20261004/native-driver.py';
const names=['README.md','plan.json','freeze.mjs','bounded-output.mjs','capture.mjs','survey.mjs','native-owned.mjs','passive-guard.mjs','native-driver.py'];
const hash=b=>createHash('sha256').update(b).digest('hex'),json=p=>JSON.parse(readFileSync(p,'utf8'));
function record(path){const p=resolve(path);assert(lstatSync(p).isFile()&&!lstatSync(p).isSymbolicLink());assert.equal(realpathSync(p),p);const body=readFileSync(p);return {path:p,bytes:body.length,sha256:hash(body)};}
function verify(pin){assert.deepEqual(record(pin.path),{path:pin.path,bytes:pin.bytes,sha256:pin.sha256});}
function walk(root){assert(lstatSync(root).isDirectory()&&!lstatSync(root).isSymbolicLink());const out=[];for(const name of readdirSync(root).sort()){const p=join(root,name),s=lstatSync(p);assert(!s.isSymbolicLink());if(s.isDirectory())out.push(...walk(p));else{assert(s.isFile());out.push(p);}}return out;}
function sources(){return [...walk(join(REPO,'src')),...['index.html','package.json','package-lock.json','tsconfig.json','vite.config.ts'].map(name=>join(REPO,name)),...walk(join(REPO,'public'))].sort();}
function save(name,value){writeFileSync(join(WORK,name),JSON.stringify(value,null,2)+'\n',{flag:'wx'});}
function rootReceipts(){const pins=['root-type-first.json','root-build-first.json'].map(name=>record(join(WORK,name))),type=json(pins[0].path),build=json(pins[1].path);for(const receipt of [type,build]){assert.equal(receipt.valid,true);assert.equal(receipt.cwd,REPO);assert.equal(receipt.result.exit_code,0);assert(receipt.recordedAt&&receipt.command);assert.equal(typeof receipt.result.wall_time_seconds,'number');}assert.equal(type.command,'node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit');assert.equal(build.buildId,'1099ddaa1-zero-mask-working');assert.equal(build.command,'BUILD_ID=1099ddaa1-zero-mask-working node node_modules/vite/bin/vite.js build --outDir '+join(WORK,'dist'));return {pins,type,build,scope:'Exact first current root tool observations; recordedAt and tool wall time only. No invented process start/end timestamps or separate stdout transcript. No V1 typing/build inheritance.'};}
const args=process.argv.slice(2);assert(args.length===0||JSON.stringify(args)===JSON.stringify(['--bind-runtime=true']));const readyPath=join(WORK,'ready.json');
if(args.length===0){
  assert.equal(process.env.ROOT_ZERO_MASK_SOURCE_REVIEWED,'true');assert(!existsSync(readyPath)&&!existsSync(join(WORK,'source'))&&!existsSync(join(WORK,'borrowed-cdp.mjs')));
  const helpers=names.map(name=>record(join(WORK,name))),plan=json(join(WORK,'plan.json'));assert.equal(plan.work,WORK);assert.equal(plan.serverPort,4259);assert.equal(plan.cdpPort,9669);assert.equal(plan.sampleSeconds,90);assert.equal(plan.warmSeconds,5);assert.equal(plan.commandSeconds,175);assert.equal(plan.cleanupSeconds,5);assert.equal(plan.wholeSeconds,180);assert.equal(plan.allOutputBytes,384*1024*1024);assert.equal(plan.rawNumericalBytes,96*1024*1024);assert.equal(plan.nativeLogBytes,512*1024);assert.equal(plan.driverLogBytes,512*1024);assert.equal(plan.driverReceiptBytes,128*1024);
  const firstRoot=rootReceipts(),originalMeter=['survey.mjs','native-owned.mjs','passive-guard.mjs'].map(name=>record(join(METER,name))),originalDriver=record(DRIVER);
  assert.equal(readFileSync(join(WORK,'native-driver.py'),'utf8'),readFileSync(DRIVER,'utf8').replace("WORK = Path('/private/tmp/surf-wavelab-passive-original-v2-20261004')","WORK = Path('"+WORK+"')"),'External driver differs beyond WORK literal');
  const sourceFiles=sources().map(record);assert.equal(sourceFiles.length,592);const sourceCopies=sourceFiles.map(pin=>{const rel=relative(REPO,pin.path);assert(rel&&!rel.startsWith('..'));const dst=join(WORK,'source',rel);mkdirSync(dirname(dst),{recursive:true});copyFileSync(pin.path,dst);const copied=record(dst);assert.equal(copied.bytes,pin.bytes);assert.equal(copied.sha256,pin.sha256);return copied;});
  const cdp=record(join(REPO,'scripts/browser/cdp.mjs'));copyFileSync(cdp.path,join(WORK,'borrowed-cdp.mjs'));const borrowed=record(join(WORK,'borrowed-cdp.mjs'));assert.equal(cdp.sha256,borrowed.sha256);
  const dist=join(WORK,'dist'),compiledFiles=walk(dist).map(path=>({...record(path),relativePath:relative(dist,path)}));assert.equal(compiledFiles.length,49);assert(compiledFiles.some(pin=>pin.relativePath==='index.html'));const workers=compiledFiles.filter(pin=>/^assets\/surfZoneWorker-[^/]+\.js$/.test(pin.relativePath));assert.equal(workers.length,1);
  const reference=record(plan.comparisonReference);assert.equal(reference.sha256,plan.comparisonReferenceSha256);const old=json(reference.path);assert.equal(old.valid,true);assert.equal(old.nativeAudit.valid,true);assert.equal(old.results.length,1);
  save('ready.json',{schema:'zero-mask-ordinary-fps-ready/v1',createdAt:new Date().toISOString(),helpers,originalMeter,originalDriver,sourceFiles,sourceCopies,cdp,borrowed,compiledFiles,worker:workers[0].relativePath,firstRoot,reference,scope:'Current root guard working tree and first root production/type observations; exact592 current sources/copies and49 already-built actual outputs pinned. No V1 runtime inheritance, virtual substitutions, rebuild or native launch by freezer.'});
  console.log(JSON.stringify({sourceFrozen:true,ready:readyPath,sourceFiles:sourceFiles.length,compiledFiles:compiledFiles.length,worker:workers[0].relativePath,sha256:hash(readFileSync(readyPath))}));
}else{
  assert.equal(process.env.ROOT_ZERO_MASK_RUNTIME_REVIEWED,'true');assert(!existsSync(join(WORK,'bindings.json')));const ready=json(readyPath),readyPin=record(readyPath);assert.equal(ready.schema,'zero-mask-ordinary-fps-ready/v1');for(const pin of [...ready.helpers,...ready.originalMeter,ready.originalDriver,...ready.sourceFiles,...ready.sourceCopies,ready.cdp,ready.borrowed,...ready.compiledFiles,...ready.firstRoot.pins,ready.reference])verify(pin);assert.deepEqual(sources(),ready.sourceFiles.map(pin=>pin.path).sort());assert.deepEqual(walk(join(WORK,'dist')).sort(),ready.compiledFiles.map(pin=>pin.path).sort());
  const checks=record(join(WORK,'root-helper-checks.json')),receipt=json(checks.path);assert.equal(receipt.valid,true);assert.equal(receipt.readySha256,readyPin.sha256);assert.equal(receipt.helperSyntaxFresh,true);assert.equal(receipt.currentSourceByteIdentityVerified,true);assert.equal(receipt.currentDistByteIdentityVerified,true);assert.equal(receipt.firstCurrentTypeBuildReceiptsVerified,true);assert(receipt.command&&receipt.recordedAt);
  save('bindings.json',{schema:'zero-mask-ordinary-fps-bindings/v1',valid:true,originalProduction:true,workingTreeCandidate:true,ready:readyPin,receipts:[...ready.firstRoot.pins,checks],compiledFiles:ready.compiledFiles,worker:ready.worker,reference:ready.reference,buildId:ready.firstRoot.build.buildId,createdAt:new Date().toISOString(),scope:'Fresh current working-tree production build and first current strict observation only, verified identical to frozen current source/copies/output files; fresh helper syntax/guards. Harness validity confers no FPS/physics/quality/adoption threshold.'});
  console.log(JSON.stringify({runtimeBound:true,worker:ready.worker,sha256:hash(readFileSync(join(WORK,'bindings.json')))}));
}
