+function expectBytes(actual: ArrayBufferView, expected: ArrayBufferView, label: string): void {
+  const a = Buffer.from(actual.buffer, actual.byteOffset, actual.byteLength);
+  const b = Buffer.from(expected.buffer, expected.byteOffset, expected.byteLength);
+  if (a.length !== b.length) throw new Error(`${label}: byte lengths ${a.length} !== ${b.length}`);
+  if (a.equals(b)) return;
+  let at = 0;
+  while (at < a.length && a[at] === b[at]) at += 1;
+  throw new Error(`${label}: byte ${at} actual ${a[at]} !== expected ${b[at]}, offsets ${actual.byteOffset}/${expected.byteOffset}`);
+}
+function expectByteArrays(actual: readonly ArrayBufferView[], expected: readonly ArrayBufferView[], label: string): void {
+  expect(actual.length).toBe(expected.length);
