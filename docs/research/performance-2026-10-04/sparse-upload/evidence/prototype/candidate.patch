+import type { ShallowWaterSolver } from '../ShallowWaterSolver';
+
+/** At most 24 small writes (three fields per range); otherwise keep the original single full upload. */
+export const MAX_WATER_RANGES = 8;
+/** Extra unchanged cells included while joining nearby rows count toward this limit too. */
+export const MAX_WATER_SHARE = 0.25;
+
+const owners = new WeakMap<ShallowWaterSolver, CpuWaterEdits>();
+
+/**
+ * @internal One worker-owned device's CPU coupling edits. Generic devices never install this tracker.
+ * It records cells, not intermediate numbers: packing happens only after all original F64 mutations.
+ */
+export class CpuWaterEdits {
+  private readonly low: Int32Array;
+  private readonly high: Int32Array;
+  /** Reused [start,end) pairs; no per-step range objects or array allocations. */
+  readonly ranges = new Int32Array(MAX_WATER_RANGES * 2);
+  private full = true;
+  private covered = 0;
+
+  constructor(private readonly solver: ShallowWaterSolver) {
+    this.low = new Int32Array(solver.nz);
+    this.high = new Int32Array(solver.nz);
+  }
+
+  invalidate(): void { this.full = true; }
+
+  mark(index: number): void {
+    if (this.full) return;
+    const { nx, nz } = this.solver;
+    if (!Number.isInteger(index) || index < 0 || index >= nx * nz) {
+      this.invalidate();
+      return;
+    }
+    const row = Math.floor(index / nx);
+    const column = index - row * nx;
+    const previous = Math.max(0, this.high[row] - this.low[row]);
+    this.low[row] = Math.min(this.low[row], column);
+    this.high[row] = Math.max(this.high[row], column + 1);
+    this.covered += this.high[row] - this.low[row] - previous;
+    if (this.covered > nx * nz * MAX_WATER_SHARE) this.invalidate();
+  }
+
+  /** -1 means full, zero means the GPU already holds every final CPU input, otherwise ranges are ready. */
+  prepare(): number {
+    if (this.full || owners.get(this.solver) !== this) return -1;
+    if (this.covered === 0) return 0;
+    const { nx, nz } = this.solver;
+    let count = 0;
+    let packed = 0;
+    let start = -1;
+    let end = -1;
+    for (let row = 0; row < nz; row += 1) {
+      if (this.low[row] >= this.high[row]) continue;
+      const nextStart = row * nx + this.low[row];
+      const nextEnd = row * nx + this.high[row];
+      // Joining consecutive/nearby rows avoids one WebGPU command per lip parcel.
+      if (start >= 0 && nextStart - end <= nx) {
+        end = nextEnd;
+        continue;
+      }
+      if (start >= 0) {
+        this.ranges[2 * count] = start;
+        this.ranges[2 * count + 1] = end;
+        packed += end - start;
+        count += 1;
+        if (count === MAX_WATER_RANGES) return -1;
+      }
+      start = nextStart;
+      end = nextEnd;
+    }
+    this.ranges[2 * count] = start;
+    this.ranges[2 * count + 1] = end;
+    packed += end - start;
+    count += 1;
+    return packed > nx * nz * MAX_WATER_SHARE ? -1 : count;
+  }
+
+  /** The mapped view must be scanned before unmap; no NaN payload may bypass the old conversion. */
+  readbackIsExact(back: Float32Array, count: number): boolean {
+    for (let i = 0; i < count; i += 1) {
+      if (Number.isNaN(back[i])) return false;
+    }
+    return true;
+  }
+
+  /** Only after normal readback, unmap and adoptDeviceStep all succeeded. */
+  adoptReadback(): void {
+    this.low.fill(this.solver.nx);
+    this.high.fill(0);
+    this.covered = 0;
+    this.full = false;
+  }
+}
+
+/** @internal Called only by GpuBoussinesq.createForWorker, never by the generic public factory. */
+export function trackCpuWaterEdits(solver: ShallowWaterSolver): CpuWaterEdits {
+  owners.get(solver)?.invalidate();
+  const edits = new CpuWaterEdits(solver);
+  owners.set(solver, edits);
+  return edits;
+}
+
+export function releaseCpuWaterEdits(solver: ShallowWaterSolver, edits: CpuWaterEdits): void {
+  edits.invalidate();
+  if (owners.get(solver) === edits) owners.delete(solver);
+}
+
+/** After an unchanged coupling write; a generic/CPU-owned solver has no tracker. */
+export function markCpuWaterCell(solver: ShallowWaterSolver, index: number): void {
+  owners.get(solver)?.mark(index);
+}
+
+/** A CPU step, warm start, import or window shift may change a whole field, including before an exception. */
+export function invalidateCpuWater(solver: ShallowWaterSolver): void {
+  owners.get(solver)?.invalidate();
+}
