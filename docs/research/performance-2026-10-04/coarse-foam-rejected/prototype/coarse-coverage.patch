+import type { ShallowWaterSolver } from './ShallowWaterSolver';
+import type { FoamDecay } from './FoamField';
+
+export interface FoamCoverageGrouping { readonly columns: number; readonly rows: number }
+export interface FoamCoverageLayout extends FoamCoverageGrouping {
+  readonly nx: number;
+  readonly nz: number;
+  /** Left cell edge of the represented solver window, m. */
+  readonly xMin: number;
+}
+interface SampleGrid { nx: number; nz: number; spacing: number; xMin: number; zMin: number }
+const TRACE = 1e-6;
+
+/** Experimental visual-only cells, grouping existing physical cells without refining offshore. */
+export class FoamCoverageGrid {
+  readonly nx: number;
+  readonly nz: number;
+  readonly xCenters: Float64Array;
+  readonly zCenters: Float64Array;
+  readonly xEdges: Float64Array;
+  readonly zEdges: Float64Array;
+  readonly dense: Float64Array;
+  readonly residual: Float64Array;
+  private readonly nextDense: Float64Array;
+  private readonly nextResidual: Float64Array;
+  private readonly water: Float64Array;
+  private readonly momentumX: Float64Array;
+  private readonly momentumZ: Float64Array;
+  private readonly sourceArea: Float64Array;
+  private readonly columnGroups: Uint32Array;
+  private readonly rowGroups: Uint32Array;
+  private windowX: number;
+  private mapping?: {
+    grid: SampleGrid; windowX: number; columns: Uint32Array; columnWeights: Float64Array;
+    rows: Uint32Array; rowWeights: Float64Array;
+  };
+
+  constructor(private readonly solver: ShallowWaterSolver, readonly grouping: FoamCoverageGrouping) {
+    if (!Number.isInteger(grouping.columns) || grouping.columns < 1 || !Number.isInteger(grouping.rows) || grouping.rows < 1) {
+      throw new Error('Invalid foam coverage grouping');
+    }
+    this.nx = Math.ceil(solver.nx / grouping.columns);
+    this.nz = Math.ceil(solver.nz / grouping.rows);
+    this.xEdges = new Float64Array(this.nx + 1);
+    this.zEdges = new Float64Array(this.nz + 1);
+    this.xCenters = new Float64Array(this.nx);
+    this.zCenters = new Float64Array(this.nz);
+    this.windowX = solver.xCenters[0];
+    for (let c = 0; c <= this.nx; c += 1) this.xEdges[c] = this.windowX - solver.dx / 2 + Math.min(solver.nx, c * grouping.columns) * solver.dx;
+    for (let r = 0; r <= this.nz; r += 1) {
+      const fine = Math.min(solver.nz - 1, r * grouping.rows);
+      this.zEdges[r] = r === this.nz ? solver.zCenters[fine] + solver.dz[fine] / 2 : solver.zCenters[fine] - solver.dz[fine] / 2;
+    }
+    for (let c = 0; c < this.nx; c += 1) this.xCenters[c] = (this.xEdges[c] + this.xEdges[c + 1]) / 2;
+    for (let r = 0; r < this.nz; r += 1) this.zCenters[r] = (this.zEdges[r] + this.zEdges[r + 1]) / 2;
+    this.columnGroups = Uint32Array.from({ length: solver.nx }, (_, c) => Math.floor(c / grouping.columns));
+    this.rowGroups = Uint32Array.from({ length: solver.nz }, (_, r) => Math.floor(r / grouping.rows) * this.nx);
+    const n = this.nx * this.nz;
+    this.dense = new Float64Array(n);
+    this.residual = new Float64Array(n);
+    this.nextDense = new Float64Array(n);
+    this.nextResidual = new Float64Array(n);
+    this.water = new Float64Array(n);
+    this.momentumX = new Float64Array(n);
+    this.momentumZ = new Float64Array(n);
+    this.sourceArea = new Float64Array(n);
+  }
+
+  area(index: number): number {
+    const r = Math.floor(index / this.nx);
+    const c = index - r * this.nx;
+    return (this.xEdges[c + 1] - this.xEdges[c]) * (this.zEdges[r + 1] - this.zEdges[r]);
+  }
+
+  fineGroup(index: number): number {
+    const r = Math.floor(index / this.solver.nx);
+    return this.rowGroups[r] + this.columnGroups[index - r * this.solver.nx];
+  }
+
+  beginMeasurement(): void {
+    this.followWindow();
+    this.water.fill(0);
+    this.momentumX.fill(0);
+    this.momentumZ.fill(0);
+    this.sourceArea.fill(0);
+  }
+
+  /** Called only for original wet fine cells, in original cell order. */
+  accumulate(index: number, h: number, qx: number, qz: number, rate: number): void {
+    const r = Math.floor(index / this.solver.nx);
+    const group = this.rowGroups[r] + this.columnGroups[index - r * this.solver.nx];
+    const area = this.solver.dx * this.solver.dz[r];
+    this.water[group] += h * area;
+    this.momentumX[group] += qx * area;
+    this.momentumZ[group] += qz * area;
+    this.sourceArea[group] += rate * area;
+  }
+
+  update(dt: number, decay: FoamDecay, laceShare: number): void {
+    const keepDense = Math.exp(-dt / decay.dense);
+    const keepLace = Math.exp(-dt / decay.residual);
+    for (let r = 0; r < this.nz; r += 1) {
+      for (let c = 0; c < this.nx; c += 1) {
+        const i = r * this.nx + c;
+        const water = this.water[i];
+        if (!(water > 0)) { this.nextDense[i] = 0; this.nextResidual[i] = 0; continue; }
+        const x = this.xCenters[c] - this.momentumX[i] / water * dt;
+        const z = this.zCenters[r] - this.momentumZ[i] / water * dt;
+        const column = this.columnBelow(x);
+        const row = this.rowBelow(z, r);
+        const tx = this.weight(this.xCenters, column, x);
+        const tz = this.weight(this.zCenters, row, z);
+        const previous = this.sample(this.dense, column, row, tx, tz);
+        let dense = previous * keepDense;
+        const lace = this.sample(this.residual, column, row, tx, tz) * keepLace + laceShare * (previous - dense);
+        dense += this.sourceArea[i] / this.area(i) * dt;
+        this.nextDense[i] = dense < TRACE ? 0 : Math.min(1, dense);
+        this.nextResidual[i] = lace < TRACE ? 0 : Math.min(lace, 1 - this.nextDense[i]);
+      }
+    }
+    this.dense.set(this.nextDense);
+    this.residual.set(this.nextResidual);
+  }
+
+  addSplash(fineIndex: number, volume: number, splashDepth: number): void {
+    this.followWindow();
+    const i = this.fineGroup(fineIndex);
+    this.dense[i] = Math.min(1, this.dense[i] + volume / (this.area(i) * splashDepth));
+    this.residual[i] = Math.min(this.residual[i], 1 - this.dense[i]);
+  }
+
+  /** Piecewise-constant area remap handles odd fine-column shifts and partial end groups. */
+  followWindow(): void {
+    const delta = this.solver.xCenters[0] - this.windowX;
+    if (delta === 0) return;
+    for (let r = 0; r < this.nz; r += 1) {
+      let first = 0;
+      for (let c = 0; c < this.nx; c += 1) {
+        const low = this.xEdges[c] + delta;
+        const high = this.xEdges[c + 1] + delta;
+        while (first < this.nx && this.xEdges[first + 1] <= low) first += 1;
+        let dense = 0;
+        let residual = 0;
+        for (let old = first; old < this.nx && this.xEdges[old] < high; old += 1) {
+          const overlap = Math.max(0, Math.min(high, this.xEdges[old + 1]) - Math.max(low, this.xEdges[old]));
+          dense += this.dense[r * this.nx + old] * overlap;
+          residual += this.residual[r * this.nx + old] * overlap;
+        }
+        const i = r * this.nx + c;
+        this.nextDense[i] = dense / (high - low);
+        this.nextResidual[i] = residual / (high - low);
+      }
+    }
+    this.dense.set(this.nextDense);
+    this.residual.set(this.nextResidual);
+    this.moveCoordinates();
+  }
+
+  layout(): FoamCoverageLayout {
+    this.followWindow();
+    return { ...this.grouping, nx: this.nx, nz: this.nz, xMin: this.xEdges[0] };
+  }
+
+  validateState(dense: ArrayLike<number> | undefined, residual: ArrayLike<number> | undefined, layout?: FoamCoverageLayout): void {
+    const size = layout ? this.dense.length : this.solver.h.length;
+    if (layout && (layout.columns !== this.grouping.columns || layout.rows !== this.grouping.rows || layout.nx !== this.nx || layout.nz !== this.nz
+      || layout.xMin !== this.solver.xCenters[0] - this.solver.dx / 2)) throw new Error('A sea state from another foam coverage grid');
+    if ((dense && dense.length !== size) || (residual && residual.length !== size) || (layout && (!dense || !residual))) {
+      throw new Error('A sea state from another foam coverage grid');
+    }
+  }
+
+  importState(dense: ArrayLike<number> | undefined, residual: ArrayLike<number> | undefined, layout?: FoamCoverageLayout): void {
+    this.validateState(dense, residual, layout);
+    this.moveCoordinates();
+    if (layout) {
+      this.dense.set(dense!); this.residual.set(residual!);
+    } else {
+      // Explicit legacy fine-state conversion: conserve represented foam area before sampling.
+      if (dense) this.downsample(dense, this.dense);
+      if (residual) this.downsample(residual, this.residual);
+    }
+  }
+
+  mappingFor(grid: SampleGrid) {
+    this.followWindow();
+    let m = this.mapping;
+    if (!m || m.grid.nx !== grid.nx || m.grid.nz !== grid.nz || m.grid.spacing !== grid.spacing || m.grid.zMin !== grid.zMin) {
+      const rows = new Uint32Array(grid.nz);
+      const rowWeights = new Float64Array(grid.nz);
+      for (let r = 0; r < grid.nz; r += 1) {
+        const z = grid.zMin + r * grid.spacing;
+        rows[r] = this.rowBelow(z, 0);
+        rowWeights[r] = this.weight(this.zCenters, rows[r], z);
+      }
+      m = { grid: { ...grid }, windowX: NaN, columns: new Uint32Array(grid.nx), columnWeights: new Float64Array(grid.nx), rows, rowWeights };
+      this.mapping = m;
+    }
+    if (m.grid.xMin !== grid.xMin || m.windowX !== this.windowX) {
+      for (let c = 0; c < grid.nx; c += 1) {
+        const x = grid.xMin + c * grid.spacing;
+        m.columns[c] = this.columnBelow(x);
+        m.columnWeights[c] = this.weight(this.xCenters, m.columns[c], x);
+      }
+      m.grid.xMin = grid.xMin; m.windowX = this.windowX;
+    }
+    return m;
+  }
+
+  sampleAt(x: number, z: number): number {
+    this.followWindow();
+    const c = this.columnBelow(x);
+    const r = this.rowBelow(z, 0);
+    const tx = this.weight(this.xCenters, c, x);
+    const tz = this.weight(this.zCenters, r, z);
+    return this.sample(this.dense, c, r, tx, tz) + this.sample(this.residual, c, r, tx, tz);
+  }
+
+  private downsample(fine: ArrayLike<number>, coarse: Float64Array): void {
+    coarse.fill(0);
+    for (let i = 0; i < fine.length; i += 1) {
+      const r = Math.floor(i / this.solver.nx);
+      coarse[this.fineGroup(i)] += fine[i] * this.solver.dx * this.solver.dz[r];
+    }
+    for (let i = 0; i < coarse.length; i += 1) coarse[i] /= this.area(i);
+  }
+
+  private moveCoordinates(): void {
+    this.windowX = this.solver.xCenters[0];
+    for (let c = 0; c < this.xEdges.length; c += 1) {
+      this.xEdges[c] = this.windowX - this.solver.dx / 2 + Math.min(this.solver.nx, c * this.grouping.columns) * this.solver.dx;
+    }
+    for (let c = 0; c < this.xCenters.length; c += 1) this.xCenters[c] = (this.xEdges[c] + this.xEdges[c + 1]) / 2;
+  }
+
+  private columnBelow(x: number): number {
+    return Math.max(0, Math.min(this.nx - 2, Math.floor((x - this.xCenters[0]) / (this.solver.dx * this.grouping.columns))));
+  }
+
+  private rowBelow(z: number, guess: number): number {
+    let row = Math.max(0, Math.min(guess, this.nz - 2));
+    while (row > 0 && this.zCenters[row] > z) row -= 1;
+    while (row < this.nz - 2 && this.zCenters[row + 1] <= z) row += 1;
+    return row;
+  }
+
+  private weight(centres: Float64Array, index: number, value: number): number {
+    return centres.length === 1 ? 0 : Math.min(1, Math.max(0, (value - centres[index]) / (centres[index + 1] - centres[index])));
+  }
+
+  private sample(values: Float64Array, c: number, r: number, tx: number, tz: number): number {
+    const c1 = Math.min(c + 1, this.nx - 1);
+    const r1 = Math.min(r + 1, this.nz - 1);
+    return values[r * this.nx + c] * (1 - tx) * (1 - tz) + values[r * this.nx + c1] * tx * (1 - tz)
+      + values[r1 * this.nx + c] * (1 - tx) * tz + values[r1 * this.nx + c1] * tx * tz;
+  }
+}
