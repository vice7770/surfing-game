+import { describe, expect, it, vi } from 'vitest';
+import { FoamField } from './FoamField';
+import { FoamField as OriginalFoam } from '../../oracle/src/wave/FoamField';
+import { AerationField } from './AerationField';
+import { AerationField as OriginalAir } from '../../oracle/src/wave/AerationField';
+import { AdvectionStencil } from './AdvectionStencil';
+import { AdvectionStencil as OriginalStencil } from '../../oracle/src/wave/AdvectionStencil';
+import { ShallowWaterSolver } from './ShallowWaterSolver';
+import { SurfZoneSimulation, type SurfZoneConfig } from './SurfZoneSimulation';
+import { SurfZoneSimulation as OriginalSimulation } from '../../oracle/src/wave/SurfZoneSimulation';
+import { encodeSurfZoneState, decodeSurfZoneState } from './surfZoneState';
+import { encodeSurfZoneState as originalEncode } from '../../oracle/src/wave/surfZoneState';
+import { BubbleCloud } from './BubbleCloud';
+import { SprayCloud } from './SprayCloud';
+import { PhysicalSurfWater } from '../physics/PhysicalSurfWater';
+import { createWaterSample } from '../physics/SurfWater';
+
+const dt = 1 / 60;
+const grouping = { columns: 2, rows: 4 };
+const decay = { dense: 3, residual: 20 };
+const bits = (values: Float64Array | Float32Array | Uint32Array | Uint8Array) => new Uint8Array(values.buffer, values.byteOffset, values.byteLength);
+function sameBits(a: Float64Array | Float32Array | Uint32Array | Uint8Array, b: Float64Array | Float32Array | Uint32Array | Uint8Array) { expect(bits(a)).toEqual(bits(b)); }
+const solver = () => new ShallowWaterSolver({ nx: 17, xMin: -17, dx: 2, zEdges: [-16, -12, -8, -5, -3, -2, -1, 0, 1, 2, 3, 4, 5, 6], xBoundary: 'open' }, () => 2);
+const originalFoam = (water: ShallowWaterSolver) => new OriginalFoam(water as unknown as ConstructorParameters<typeof OriginalFoam>[0], decay);
+const originalAir = (water: ShallowWaterSolver) => new OriginalAir(water as unknown as ConstructorParameters<typeof OriginalAir>[0], { period: 10 });
+
+function waterSequence(water: ShallowWaterSolver, frame: number, breaking: Float64Array) {
+  for (let i = 0; i < water.h.length; i += 1) {
+    water.bed[i] = -1 - (i % 5) * 0.2;
+    water.h[i] = (i + frame) % 19 === 0 ? 0 : (i + frame) % 7 === 0 ? 0.4 : 1.5 + ((i * 3 + frame) % 11) / 12;
+    water.qx[i] = water.h[i] * ((i % 9) - 4) / 8;
+    water.qz[i] = water.h[i] * (((i * 5 + frame) % 13) - 3) / 7;
+    breaking[i] = (i + frame) % 5 === 0 ? 0 : 0.1 + ((i * 3 + frame) % 7) / 8;
+  }
+}
+
+function bores(foam: FoamField | OriginalFoam, air: AerationField | OriginalAir, water: ShallowWaterSolver, breaking: Float64Array) {
+  for (let n = 0; n < foam.breakingCount; n += 1) {
+    const i = foam.breakingCells[n];
+    if (foam.dissipation[i] > 0) air.addBore(i, foam.dissipation[i], water.h[i] - (water.restLevel - water.bed[i]), dt);
+    air.stir(i, breaking[i], dt);
+  }
+}
+
+function sourceParity(a: FoamField, b: OriginalFoam) {
+  expect(a.sourceCount).toBe(b.sourceCount);
+  expect(a.breakingCount).toBe(b.breakingCount);
+  sameBits(a.source, b.source);
+  sameBits(a.sourceCells, b.sourceCells); // includes original inactive tails
+  sameBits(a.breakingCells, b.breakingCells);
+  sameBits(a.dissipation, b.dissipation); // inactive values intentionally remain stale
+}
+
+describe('coarse coverage physical boundary against archived 58ceb', () => {
+  it('retains the default fine implementation including coverage and state marker absence', () => {
+    const water = solver(); const a = new FoamField(water, decay); const b = originalFoam(water);
+    a.dense.fill(0.35); b.dense.fill(0.35); a.residual.fill(0.1); b.residual.fill(0.1);
+    const breaking = new Float64Array(water.h.length);
+    for (let frame = 0; frame < 6; frame += 1) {
+      waterSequence(water, frame, breaking); a.update(dt, breaking); b.update(dt, breaking);
+      sourceParity(a, b); sameBits(a.dense, b.dense); sameBits(a.residual, b.residual);
+    }
+    expect(a.coverageLayout()).toBeUndefined();
+  });
+
+  it('preserves full fine source/list/dissipation bytes and all air/turbulence bytes through wet/dry and window changes', () => {
+    const water = solver();
+    const fine = originalFoam(water); const coarse = new FoamField(water, decay, grouping);
+    const beforeAir = originalAir(water); const afterAir = new AerationField(water, { period: 10 });
+    const fineStencil = new OriginalStencil(); const unusedStencil = new AdvectionStencil();
+    fine.dissipation.fill(123.5); coarse.dissipation.fill(123.5);
+    const breaking = new Float64Array(water.h.length);
+    for (let frame = 0; frame < 14; frame += 1) {
+      if (frame === 3) water.shiftAlongShore(1);
+      if (frame === 5) water.shiftAlongShore(-1);
+      if (frame === 7) water.shiftAlongShore(2);
+      if (frame === 9) water.shiftAlongShore(-2);
+      waterSequence(water, frame, breaking);
+      const x = water.xCenters[8]; const z = water.zCenters[7];
+      if (frame % 3 === 0) {
+        fine.addSplash(x, z, 0.015); coarse.addSplash(x, z, 0.015);
+        beforeAir.addPlunge(x, z, 100, 0.4); afterAir.addPlunge(x, z, 100, 0.4);
+      }
+      if (frame % 4 === 0) { beforeAir.addAir(x, z, 0.03, 0.3); afterAir.addAir(x, z, 0.03, 0.3); }
+      const physical = [water.h, water.qx, water.qz, water.bed, water.xCenters, water.zCenters].map(a => a.slice());
+      const input = breaking.slice();
+      // Prove invalidation rather than assuming an untouched scratch stencil is empty.
+      unusedStencil.begin(water, dt); unusedStencil.commit();
+      fine.update(dt, breaking, fineStencil); coarse.update(dt, breaking, unusedStencil);
+      expect(unusedStencil.take(water, dt)).toBeUndefined();
+      sourceParity(coarse, fine);
+      bores(fine, beforeAir, water, breaking); bores(coarse, afterAir, water, breaking);
+      beforeAir.update(dt, fineStencil); afterAir.update(dt); // original full fine fallback
+      sameBits(afterAir.air, beforeAir.air); sameBits(afterAir.depth, beforeAir.depth); sameBits(afterAir.turbulence, beforeAir.turbulence);
+      [water.h, water.qx, water.qz, water.bed, water.xCenters, water.zCenters].forEach((values, i) => sameBits(values, physical[i]));
+      sameBits(breaking, input);
+      const hitA = new PhysicalSurfWater(water, { peakPeriod: 10, breaking, aeration: afterAir });
+      const hitB = new PhysicalSurfWater(water, { peakPeriod: 10, breaking, aeration: beforeAir });
+      for (const y of [-1, -0.3, 0.2]) expect(hitA.sampleAt(x, y, z, createWaterSample())).toEqual(hitB.sampleAt(x, y, z, createWaterSample()));
+    }
+    expect(coarse.coverage!.nx * coarse.coverage!.nz).toBe(36); // ceil(17/2)*ceil(13/4)
+    expect(fine.dense.length).toBe(221);
+  });
+
+  it('retains fixed-RNG bubble/spray births on the same fine source and ordered impact stream', () => {
+    const water = solver(); const fine = originalFoam(water); const coarse = new FoamField(water, decay, grouping);
+    const bubbleA = new BubbleCloud(8761, 256); const bubbleB = new BubbleCloud(8761, 256);
+    const sprayA = new SprayCloud(8761, 512); const sprayB = new SprayCloud(8761, 512);
+    const breaking = new Float64Array(water.h.length);
+    for (let frame = 0; frame < 8; frame += 1) {
+      waterSequence(water, frame, breaking);
+      fine.update(dt, breaking); coarse.update(dt, breaking);
+      sourceParity(coarse, fine);
+      const impact = { x: water.xCenters[8], z: water.zCenters[7], volume: 0.02, vx: 0.3, vy: -3, vz: 2 };
+      const base = { solver: water, lipImpacts: [impact], windSpeed: -5 };
+      bubbleA.update({ solver: water, foam: fine }, dt); bubbleB.update({ solver: water, foam: coarse }, dt);
+      sprayA.update({ ...base, foam: fine }, dt);
+      sprayB.update({ ...base, foam: coarse }, dt);
+      expect(bubbleA.count).toBe(bubbleB.count); sameBits(bubbleA.positions, bubbleB.positions);
+      expect(sprayA.count).toBe(sprayB.count); sameBits(sprayA.particles, sprayB.particles);
+    }
+    expect(bubbleA.count).toBeGreaterThan(0); expect(sprayA.count).toBeGreaterThan(0);
+  });
+});
+
+const config: SurfZoneConfig = { spot: 'beach', seed: 8761, significantHeight: 1.5, peakPeriod: 10, directionDegrees: 10,
+  spreading: 12, tide: 0, alongShore: 34, dx: 2, fineSpacing: 2, coarseSpacing: 8, componentCount: 6, stage: 1, spinUpPeriods: 0 };
+const simulation = (coarse: boolean) => new SurfZoneSimulation(config, 'warm', undefined, coarse ? { foamCoverage: grouping } : undefined);
+
+describe('coarse foam experimental simulation state and fused snapshots', () => {
+  it('keeps all fused physical channels and physical export arrays bit-exact to original simulation', () => {
+    const fine = new OriginalSimulation(config, 'warm'); const coarse = simulation(true);
+    const breaking = new Float64Array(coarse.solver.h.length);
+    waterSequence(coarse.solver, 2, breaking); waterSequence(fine.solver as unknown as ShallowWaterSolver, 2, breaking);
+    for (let i = 0; i < fine.solver.h.length; i += 1) {
+      coarse.aeration.air[i] = fine.aeration.air[i] = (i % 7) / 100;
+      coarse.aeration.depth[i] = fine.aeration.depth[i] = (i % 9) / 10;
+    }
+    coarse.foam.dense.fill(0.4); coarse.foam.residual.fill(0.1);
+    for (const shift of [0, 1, -1, 2]) {
+      if (shift) { coarse.solver.shiftAlongShore(shift); fine.solver.shiftAlongShore(shift); }
+      for (const spacing of [1, 2, 3]) {
+        const grid = coarse.renderGrid(spacing);
+        const n = grid.nx * grid.nz * 2;
+        const a = [new Float32Array(n), new Float32Array(n), new Float32Array(n)];
+        const b = [new Float32Array(n), new Float32Array(n), new Float32Array(n)];
+        coarse.writeUniformSnapshot(a[0], a[1], a[2], grid); fine.writeUniformSnapshot(b[0], b[1], b[2], grid);
+        const aa = new Uint32Array(a[0].buffer); const bb = new Uint32Array(b[0].buffer);
+        for (let o = 0; o < n; o += 2) expect(aa[o]).toBe(bb[o]);
+        sameBits(a[1], b[1]); sameBits(a[2], b[2]);
+        const bedA = new Float32Array(n / 2); const bedB = new Float32Array(n / 2);
+        coarse.writeUniformBed(bedA, grid); fine.writeUniformBed(bedB, grid); sameBits(bedA, bedB);
+        const separate = new Float32Array(n); coarse.writeUniformSurface(separate, grid, false); sameBits(separate, a[0]);
+        for (let r = 0; r < grid.nz; r += 1) for (let c = 0; c < grid.nx; c += 1) {
+          const o = (r * grid.nx + c) * 2;
+          if (a[0][o + 1] > 0) expect(a[0][o + 1]).toBeCloseTo(coarse.foam.coverage!.sampleAt(grid.xMin + c * spacing, grid.zMin + r * spacing), 6);
+        }
+      }
+    }
+    const a = coarse.exportState(); const b = fine.exportState();
+    for (const [name, values] of Object.entries(a.arrays)) if (!name.startsWith('foam.')) sameBits(values, b.arrays[name]);
+    expect(a.counters).toEqual(b.counters); expect(a.lip).toEqual(b.lip); expect(a.front).toEqual(b.front);
+    expect(simulation(false).exportState().foamCoverage).toBeUndefined();
+  });
+
+  it('preserves actual ordered lip landing callbacks and physical aeration inputs', () => {
+    const fine = new OriginalSimulation(config, 'warm'); const coarse = simulation(true);
+    const a: unknown[] = []; const b: unknown[] = [];
+    for (const [scene, events] of [[fine, a], [coarse, b]] as const) {
+      const splash = scene.foam.addSplash.bind(scene.foam);
+      vi.spyOn(scene.foam, 'addSplash').mockImplementation((...args) => { events.push(['splash', ...args]); splash(...args); });
+      const impact = scene.lipImpacts.push.bind(scene.lipImpacts);
