+import { describe, expect, it } from 'vitest';
+import { FoamCoverageGrid } from './FoamCoverageGrid';
+import { FoamField, SPLASH_DEPTH } from './FoamField';
+import { ShallowWaterSolver, uniformEdges } from './ShallowWaterSolver';
+
+const lasting = { dense: 1e9, residual: 1e9 };
+const grouping = { columns: 2, rows: 4 };
+const water = (nx = 5, edges: ArrayLike<number> = uniformEdges(0, 4, 4), dx = 1) =>
+  new ShallowWaterSolver({ nx, xMin: 0, dx, zEdges: edges, xBoundary: 'open' }, () => 2);
+const area = (grid: FoamCoverageGrid, values: Float64Array) => values.reduce((sum, value, i) => sum + value * grid.area(i), 0);
+
+describe('experimental grouped foam coverage', () => {
+  it('groups actual stretched edges, keeping partial groups and never refining offshore', () => {
+    const solver = water(5, [-10, -6, -3, -2, -1, 0, 4], 2);
+    const grid = new FoamCoverageGrid(solver, grouping);
+    expect([grid.nx, grid.nz]).toEqual([3, 2]);
+    expect(Array.from(grid.xEdges)).toEqual([0, 4, 8, 10]);
+    expect(Array.from(grid.zEdges)).toEqual([-10, -1, 4]);
+    expect(Array.from(grid.xCenters)).toEqual([2, 6, 9]);
+    expect(Array.from(grid.zCenters)).toEqual([-5.5, 1.5]);
+    expect(Array.from(grid.dense, (_, i) => grid.area(i))).toEqual([36, 36, 18, 20, 20, 10]);
+    expect(grid.dense.length).toBe(Math.ceil(solver.nx / 2) * Math.ceil(solver.nz / 4));
+    for (let i = 0; i < solver.h.length; i += 1) {
+      const r = Math.floor(i / solver.nx);
+      expect(grid.fineGroup(i)).toBe(Math.floor(r / 4) * grid.nx + Math.floor((i % solver.nx) / 2));
+    }
+  });
+
+  it('samples and advects finite coverage when both coarse axes have one cell', () => {
+    const solver = water(2, [0, 1, 2]);
+    const foam = new FoamField(solver, lasting, grouping);
+    foam.dense[0] = 0.4; foam.residual[0] = 0.1;
+    solver.qx.fill(5); solver.qz.fill(-3);
+    foam.update(1 / 60, new Float64Array(solver.h.length));
+    expect(foam.dense.length).toBe(1);
+    expect(foam.coverage!.sampleAt(-100, 100)).toBeCloseTo(0.5, 9);
+    const m = foam.coverage!.mappingFor({ nx: 3, nz: 3, spacing: 2, xMin: -2, zMin: -2 });
+    expect(Array.from(m.columns)).toEqual([0, 0, 0]);
+    expect(Array.from(m.rows)).toEqual([0, 0, 0]);
+    expect(Array.from(m.columnWeights)).toEqual([0, 0, 0]);
+    expect(Array.from(m.rowWeights)).toEqual([0, 0, 0]);
+  });
+
+  it('area-averages source forcing, clears fully dry groups and bounds mixed groups', () => {
+    const solver = water(5);
+    const foam = new FoamField(solver, lasting, grouping);
+    solver.bed.fill(-1); solver.h.fill(1.25);
+    const breaking = new Float64Array(solver.h.length).fill(1);
+    for (let r = 0; r < solver.nz; r += 1) {
+      solver.h[r * solver.nx] = 0;
+      solver.h[r * solver.nx + 4] = 0;
+    }
+    foam.dense.fill(0.1); foam.residual.fill(0.2);
+    foam.update(0.1, breaking);
+    expect(foam.dense[0]).toBeCloseTo(0.3, 8); // one of its two columns is wet
+    expect(foam.dense[1]).toBeCloseTo(0.5, 8);
+    expect(foam.dense[2]).toBe(0);
+    expect(foam.residual[2]).toBe(0);
+    foam.update(1, breaking);
+    expect(foam.dense.every(v => v >= 0 && v <= 1)).toBe(true);
+    expect(foam.dense.every((v, i) => v + foam.residual[i] <= 1)).toBe(true);
+  });
+
+  it('preserves an unsaturated splash dose on a partial stretched group', () => {
+    const solver = water(5, [-10, -6, -3, -2, -1, 0, 4]);
+    const grid = new FoamCoverageGrid(solver, grouping);
+    const fine = solver.h.length - 1;
+    grid.addSplash(fine, 0.001, SPLASH_DEPTH);
+    expect(grid.area(grid.fineGroup(fine))).toBe(5);
+    expect(area(grid, grid.dense)).toBeCloseTo(0.001 / SPLASH_DEPTH, 14);
+    grid.residual.fill(0.5);
+    grid.addSplash(fine, 10, SPLASH_DEPTH);
+    expect(grid.dense[grid.fineGroup(fine)]).toBe(1);
+    expect(grid.residual[grid.fineGroup(fine)]).toBe(0);
+  });
+
+  it('remaps odd shifts by actual overlap and loses only out-of-window represented area', () => {
+    const solver = water();
+    const grid = new FoamCoverageGrid(solver, grouping);
+    grid.dense.set([0.2, 0.6, 0.8]); grid.residual.set([0.1, 0.2, 0.3]);
+    solver.shiftAlongShore(1);
+    grid.followWindow();
+    expect(Array.from(grid.dense)).toEqual([0.4, 0.7, 0]);
+    expect(area(grid, grid.dense)).toBeCloseTo(2.2 * 4, 12);
+    expect(Array.from(grid.xEdges)).toEqual([1, 3, 5, 6]);
+    const retained = grid.dense.slice();
+    grid.followWindow();
+    expect(grid.dense).toEqual(retained);
+    solver.shiftAlongShore(-1);
+    grid.followWindow();
+    expect(Array.from(grid.dense)).toEqual([0.2, 0.55, 0.7]);
+    expect(area(grid, grid.dense)).toBeCloseTo(2.2 * 4, 12);
+  });
+
+  it('handles even, full-width and negative shifts, including partial entering cells', () => {
+    const solver = water();
+    const grid = new FoamCoverageGrid(solver, grouping);
+    grid.dense.set([0.2, 0.6, 0.8]);
+    solver.shiftAlongShore(-2); grid.followWindow();
+    expect(Array.from(grid.dense)).toEqual([0, 0.2, 0.6]);
+    for (let c = 0; c < solver.nx; c += 1) solver.xCenters[c] += 20;
+    grid.followWindow();
+    expect(area(grid, grid.dense)).toBe(0);
+  });
+
+  it('synchronizes before splash, avoids a second shift, and rejects the original open edge', () => {
+    const solver = water(20, uniformEdges(0, 8, 8));
+    const foam = new FoamField(solver, lasting, grouping);
+    solver.shiftAlongShore(1);
+    const x = solver.xCenters[10]; const z = solver.zCenters[2];
+    foam.addSplash(x, z, 0.01);
+    const dose = foam.dense.slice();
+    foam.coverage!.followWindow();
+    expect(foam.dense).toEqual(dose);
+    expect(area(foam.coverage!, foam.dense)).toBeCloseTo(0.01 / SPLASH_DEPTH, 14);
+    foam.addSplash(solver.xCenters[0] - solver.dx, z, 10);
+    expect(foam.dense).toEqual(dose);
+  });
+
+  it('explicitly converts fine state by actual area and rejects incompatible shape/origin', () => {
+    const solver = water(5, [-10, -6, -3, -2, -1, 0, 4]);
+    const foam = new FoamField(solver, lasting, grouping);
+    const dense = Float64Array.from(solver.h, (_, i) => (i % 5) / 10);
+    const residual = Float64Array.from(solver.h, (_, i) => (i % 3) / 20);
+    foam.importCoverageState(dense, residual);
+    const fineArea = dense.reduce((sum, value, i) => sum + value * solver.dx * solver.dz[Math.floor(i / solver.nx)], 0);
+    expect(area(foam.coverage!, foam.dense)).toBeCloseTo(fineArea, 12);
+    const layout = foam.coverageLayout()!;
+    const saved = foam.dense.slice();
+    foam.dense.fill(0); foam.importCoverageState(saved, foam.residual.slice(), layout);
+    expect(foam.dense).toEqual(saved);
+    expect(() => foam.importCoverageState(saved, foam.residual, { ...layout, columns: 4 })).toThrow('another foam');
+    expect(() => foam.importCoverageState(saved, foam.residual, { ...layout, xMin: 1 })).toThrow('another foam');
+    expect(() => new FoamField(solver, lasting).importCoverageState(saved, foam.residual, layout)).toThrow('another foam');
+    expect(() => foam.importCoverageState(saved, foam.residual)).toThrow('another foam');
+  });
+
+  it('invalidates cached sample columns when only the solver window changes', () => {
+    const solver = water(8, uniformEdges(0, 8, 8));
+    const foam = new FoamField(solver, lasting, grouping);
+    const grid = { nx: 5, nz: 4, spacing: 1, xMin: 2, zMin: 1 };
+    const old = foam.coverage!.mappingFor(grid).columnWeights.slice();
+    solver.shiftAlongShore(1);
+    const next = foam.coverage!.mappingFor(grid);
+    expect(next.columnWeights).not.toEqual(old);
+    expect(next.windowX).toBe(solver.xCenters[0]);
+  });
+});
