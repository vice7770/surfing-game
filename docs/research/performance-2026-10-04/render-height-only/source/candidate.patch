+/**
+ * Height-only CPU mirror for the Rich barrel. The weights, clamped node indices
+ * and sixteen additions match sampleCubicSurface; no slope work or temporary
+ * arrays are needed when the caller only reads height.
+ */
+export function sampleCubicHeight(data: Float32Array, grid: SurfaceGrid, x: number, z: number): number {
+  const gx = (x - grid.xMin) / grid.spacing;
+  const gz = (z - grid.zMin) / grid.spacing;
+  const i0 = Math.floor(gx);
+  const j0 = Math.floor(gz);
+  const tx = gx - i0;
+  const tz = gz - j0;
+  const tx2 = tx * tx;
+  const tx3 = tx2 * tx;
+  const tz2 = tz * tz;
+  const tz3 = tz2 * tz;
+  const wx0 = (-tx3 + 2 * tx2 - tx) / 2;
+  const wx1 = (3 * tx3 - 5 * tx2 + 2) / 2;
+  const wx2 = (-3 * tx3 + 4 * tx2 + tx) / 2;
+  const wx3 = (tx3 - tx2) / 2;
+  const wz0 = (-tz3 + 2 * tz2 - tz) / 2;
+  const wz1 = (3 * tz3 - 5 * tz2 + 2) / 2;
+  const wz2 = (-3 * tz3 + 4 * tz2 + tz) / 2;
+  const wz3 = (tz3 - tz2) / 2;
+  let height = 0;
+  for (let j = 0; j < 4; j += 1) {
+    const row = Math.min(grid.nz - 1, Math.max(0, j0 + j - 1));
+    const wz = j === 0 ? wz0 : j === 1 ? wz1 : j === 2 ? wz2 : wz3;
+    for (let i = 0; i < 4; i += 1) {
+      const column = Math.min(grid.nx - 1, Math.max(0, i0 + i - 1));
+      const value = data[(row * grid.nx + column) * 2];
+      const wx = i === 0 ? wx0 : i === 1 ? wx1 : i === 2 ? wx2 : wx3;
+      height += wz * wx * value;
+    }
+  }
+  return height;
+}
