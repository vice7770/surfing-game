+/** Complete stored-segment clearance, after the independent proper-crossing check. */
+function cavityClearance(p: Float32Array, preservedCarrierStart: number): number {
+  let minimum = Infinity;
+  for (let a = preservedCarrierStart; a < 60; a += 1) for (let b = 68; b < 102; b += 1) {
+    const ax = p[2 * a], ay = p[2 * a + 1], dx = p[2 * a + 2] - ax, dy = p[2 * a + 3] - ay;
+    const bx = p[2 * b], by = p[2 * b + 1], ex = p[2 * b + 2] - bx, ey = p[2 * b + 3] - by;
+    const den = dx * ey - dy * ex;
+    if (den !== 0) {
+      const t = ((bx - ax) * ey - (by - ay) * ex) / den, u = ((bx - ax) * dy - (by - ay) * dx) / den;
+      if (t >= 0 && t <= 1 && u >= 0 && u <= 1) return 0;
+    }
+    minimum = Math.min(minimum, pointSegmentDistance(p, a, b), pointSegmentDistance(p, a + 1, b),
+      pointSegmentDistance(p, b, a), pointSegmentDistance(p, b + 1, a));
+  }
+  return minimum;
+}
