+function pointSegmentDistance(p: Float32Array, vertex: number, segment: number): number {
+  const ax = p[2 * segment], ay = p[2 * segment + 1];
+  const dx = p[2 * segment + 2] - ax, dy = p[2 * segment + 3] - ay;
+  const x = p[2 * vertex], y = p[2 * vertex + 1];
+  const t = Math.max(0, Math.min(1, ((x - ax) * dx + (y - ay) * dy) / (dx * dx + dy * dy || 1)));
+  return Math.hypot(x - ax - t * dx, y - ay - t * dy);
+}
