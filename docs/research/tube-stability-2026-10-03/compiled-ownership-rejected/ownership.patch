+
+/** One stencil bit belongs to surviving swept fragments; neither their colour nor depth is written yet. */
+export function configureBarrelOwnership(material: MeshPhysicalMaterial): void {
+  material.colorWrite = false;
+  material.depthWrite = false;
+  material.stencilWrite = true;
+  material.stencilRef = 1;
+  material.stencilFunc = AlwaysStencilFunc;
+  material.stencilFuncMask = material.stencilWriteMask = 1;
+  material.stencilFail = material.stencilZFail = KeepStencilOp;
+  material.stencilZPass = ReplaceStencilOp;
+}
+
+/** Three enables stencil testing through `stencilWrite`; the zero write mask keeps this pass read-only. */
+export function configureBarrelWater(material: MeshPhysicalMaterial): void {
+  material.stencilWrite = false;
+  material.stencilRef = 0;
+  material.stencilFunc = EqualStencilFunc;
+  material.stencilFuncMask = 1;
+  material.stencilWriteMask = 0;
+  material.stencilFail = material.stencilZFail = material.stencilZPass = KeepStencilOp;
+}
